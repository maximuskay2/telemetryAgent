{
  "version": 1,
  "author": "TelemetryAgent",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht", "top": 40, "left": 260, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn", "top": 180, "left": 60, "attrs": { "color": "red", "label": "DOOR" } },
    { "type": "wokwi-potentiometer", "id": "pot", "top": 180, "left": 260, "attrs": { "label": "CURRENT" } }
