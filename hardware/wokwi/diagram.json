  "connections": [
    ["esp:TX0", "$serialMonitor:RX", ""],
    ["esp:RX0", "$serialMonitor:TX", ""],
    ["esp:3V3", "dht:VCC", "red"],
    ["esp:GND.1", "dht:GND", "black"],
    ["dht:SDA", "esp:D4", "green"],
    ["esp:3V3", "pot:VCC", "red"],
    ["esp:GND.2", "pot:GND", "black"],
    ["pot:SIG", "esp:D34", "orange"],
    ["esp:GND.1", "btn:1.l", "black"],
    ["btn:2.r", "esp:D15", "yellow"],
    ["esp:D13", "led_comp:A", "green"],
    ["led_comp:C", "r_comp:1", "green"],
    ["r_comp:2", "esp:GND.1", "black"],
    ["esp:D12", "led_defrost:A", "blue"],
    ["led_defrost:C", "r_defrost:1", "blue"],
    ["r_defrost:2", "esp:GND.1", "black"],
    ["esp:D14", "led_backup:A", "yellow"],
    ["led_backup:C", "r_backup:1", "yellow"],
    ["r_backup:2", "esp:GND.1", "black"]
  ],
  "dependencies": {}
