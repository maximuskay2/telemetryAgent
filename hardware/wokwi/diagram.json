    ["dht:SDA", "esp:D4", "green"],
    ["esp:3V3", "pot:VCC", "red"],
    ["esp:GND.2", "pot:GND", "black"],
    ["pot:SIG", "esp:D34", "orange"],
    ["esp:GND.1", "btn:1.l", "black"],
    ["btn:2.r", "esp:D15", "yellow"]
