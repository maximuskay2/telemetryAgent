{
  "version": 1,
  "author": "TelemetryAgent",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht", "top": 40, "left": 260, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn", "top": 180, "left": 60, "attrs": { "color": "red", "label": "DOOR" } },
    { "type": "wokwi-potentiometer", "id": "pot", "top": 180, "left": 260, "attrs": { "label": "CURRENT" } },
    { "type": "wokwi-led", "id": "led_comp", "top": 300, "left": 40, "attrs": { "color": "green", "label": "COMP" } },
    { "type": "wokwi-resistor", "id": "r_comp", "top": 330, "left": 40, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "led_defrost", "top": 300, "left": 150, "attrs": { "color": "blue", "label": "DEFROST" } },
    { "type": "wokwi-resistor", "id": "r_defrost", "top": 330, "left": 150, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "led_backup", "top": 300, "left": 260, "attrs": { "color": "yellow", "label": "BACKUP" } },
    { "type": "wokwi-resistor", "id": "r_backup", "top": 330, "left": 260, "attrs": { "value": "220" } }
