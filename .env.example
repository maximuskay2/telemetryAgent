# TelemetryAgent — copy to .env and fill in (Day 0)
# Meta Model API (diagnosis + escalation)
MODEL_API_KEY=
META_DIAGNOSIS_MODEL=muse-spark-1.3
META_ESCALATION_MODEL=muse-wonder-1.0

# Baseten — primary patch provider (Muse Spark Open)
BASETEN_API_KEY=
BASETEN_PATCH_MODEL=meta-models/muse-spark-open-1026

# Fireworks — backup patch provider (Muse Spark Open)
FIREWORKS_API_KEY=
FIREWORKS_PATCH_MODEL=

# Modal Sandbox verification (primary; or `modal setup` once instead)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Local Docker verification (fallback when Modal is unreachable)
# TA_VERIFY=local forces Docker; build the image once per machine:
#   ./scripts/build-sandbox-image.sh
TA_VERIFY=
DOCKER_BIN=
TA_SANDBOX_IMAGE=telemetry-agent-sandbox

# Mobile veto windows (M0): server-owned countdown before auto-apply.
# MOBILE_API_TOKEN gates approve/disapprove (+ apply endpoints when set).
AUTO_ACTION_SECONDS=20
AUTO_ACTION_ENABLED=true
MOBILE_API_TOKEN=

# GitHub — real PRs on the demo target repo (Day 4)
GITHUB_TOKEN=
GITHUB_DEMO_REPO=owner/repo
GITHUB_BASE_BRANCH=main

# Simulation (Sim 0): mini shop serves here
SHOP_PORT=8002

# Simulation (Sim 4): fridge stream (1 tick = 1 simulated minute)
# FRIDGE_STREAM=1 starts ticking at API boot; fault/action buttons start it anyway.
FRIDGE_STREAM=0
FRIDGE_TICK_S=1.0

# Production route (docs/USAGE.md part C)
# PRODUCTION_CONNECT_ENABLED=0 hides /connect; TA_FIXTURE_KEYS=1 is for tests only.
PRODUCTION_CONNECT_ENABLED=1
# If set, /connect and every /api/connections route need this code
# (X-Connect-Code header). Set it on any instance reachable from the internet.
CONNECT_ACCESS_CODE=
TA_FIXTURE_KEYS=0
# Railway rollback/restart adapter (customer hosting step).
RAILWAY_TOKEN=
