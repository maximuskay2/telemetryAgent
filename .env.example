# TelemetryAgent — copy to .env and fill in (Day 0)
# Meta Model API (diagnosis + escalation)
MODEL_API_KEY=
META_DIAGNOSIS_MODEL=muse-spark-1.3
META_ESCALATION_MODEL=muse-wonder-1.0

# Baseten — primary patch provider (Muse Spark Open)
BASETEN_API_KEY=
BASETEN_PATCH_MODEL=meta-models/muse-spark-open

# Fireworks — backup patch provider (Muse Spark Open)
FIREWORKS_API_KEY=
FIREWORKS_PATCH_MODEL=

# Modal Sandbox verification
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# GitHub — real PRs on the demo target repo (Day 4)
GITHUB_TOKEN=
GITHUB_DEMO_REPO=owner/repo
GITHUB_BASE_BRANCH=main

# Simulation (Sim 0): mini shop serves here
SHOP_PORT=8002
